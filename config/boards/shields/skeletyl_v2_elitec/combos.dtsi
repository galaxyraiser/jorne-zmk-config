compatible = "zmk,combos";

#define COMBO(NAME, BINDINGS, KEYPOS, LAYERS, TIMEOUT) \
    combo_##NAME {                              \
        bindings = <BINDINGS>;                  \
        key-positions = <KEYPOS>;               \
        layers = <LAYERS>;                      \
        timeout-ms = <TIMEOUT>;                 \
        slow-release;                           \
    }

