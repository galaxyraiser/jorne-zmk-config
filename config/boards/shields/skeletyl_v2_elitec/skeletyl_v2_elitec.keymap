#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1250  // default: 600
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define NAV     1
#define SYM     2
#define NUM     3

/* Mouse actions */
#define MU MOVE_UP
#define MD MOVE_DOWN
#define ML MOVE_LEFT
#define MR MOVE_RIGHT
#define SU MOVE_Y(ZMK_POINTING_DEFAULT_MOVE_VAL)
#define SD MOVE_Y(-ZMK_POINTING_DEFAULT_MOVE_VAL)
#define SR MOVE_X(ZMK_POINTING_DEFAULT_MOVE_VAL)
#define SL MOVE_X(-ZMK_POINTING_DEFAULT_MOVE_VAL)


&msc {
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
    acceleration-exponent = <0>;
};

&mmv {
    time-to-max-speed-ms = <200>;
    delay-ms = <0>;
    acceleration-exponent = <1>;
};

#define LSHFT_SPC &mt LSHFT BSPC
#define LGUI_TAB  &mt LGUI TAB
#define LCTRL_DEL &mt LCTRL DEL

#define LALT_X      &mt LALT X
#define LALT_DOT    &mt LALT DOT

#define UP_PGUP     &mt PG_UP UP
#define DN_PGDN     &mt PG_DN DOWN

/ {
    combos {
        #include "combos.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                        &kp Q       &kp W        &kp F        &kp P        &kp B               &kp J       &kp L         &kp U        &kp Y         &kp SEMI
                        &kp A       &kp R        &kp S        &kp T        &kp G               &kp M       &kp N         &kp E        &kp I         &kp O
                        &kp Z       LALT_X       &kp C        &kp D        &kp V               &kp K       &kp H         &kp COMMA    LALT_DOT      &kp FSLH
                                                 &lt NAV ESC  LSHFT_SPC    LGUI_TAB            &lt SYM RET &lt NUM SPACE LCTRL_DEL
            >;
        };

        nav_layer {
            bindings = <
                        &kp C_VOL_UP &none       &mmv MU     &none       &msc SU             &kp LC(Y)   &kp LC(V)   &kp LC(C)   &kp LC(X)   &kp LC(Z)
                        &kp C_VOL_DN &mmv ML     &mmv MD     &mmv MR     &msc SD             &kp LEFT    &kp LEFT    UP_PGUP     &kp RIGHT   &none
                        &none        &msc ML     &none       &msc SR     &none               &kp INS     &kp HOME    DN_PGDN     &kp END     &none
                                                 &mkp MB1    &trans      &trans              &kp RET     &mkp MB1    &mkp MB2
            >;
        };

        sym_layer {
            bindings = <
                        &none       &kp DLLR    &kp LPAR    &kp RPAR     &kp KP_PLUS         &kp PRCNT   &kp AT      &none       &none       &none
                        &kp COLON   &kp TILDE   &kp LBRC    &kp RBRC     &kp KP_MINUS        &kp EQUAL   &kp PIPE    &kp UNDER   &kp STAR    &kp AMPS
                        &none       &kp EXCL    &kp LBKT    &kp RBKT     &kp HASH            &kp CARET   &kp LT      &kp GT      &none       &none
                                                &trans      &trans       &trans              &trans      &none       &none
            >;
        };

        num_layer {
            bindings = <
                        &kp LBKT    &kp N7      &kp N8      &kp N9     &kp RBKT             &none       &none       &none       &none       &none
                        &kp SQT     &kp N4      &kp N5      &kp N6     &kp EQUAL            &none       &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI
                        &kp GRAVE   &kp N1      &kp N2      &kp N3     &kp BSLH             &none       &none       &none       &none       &none
                                                &kp DOT     &kp N0     LGUI_TAB             &none       &trans      &none
            >;
        };
    };
};
